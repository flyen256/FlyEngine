<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\FlyEngine.Core\FlyEngine.Core.csproj" />
        <ProjectReference Include="..\FlyEngine.Network\FlyEngine.Network.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    </ItemGroup>
    
    <ItemGroup>
      <None Update="lib\CMakeProject1.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="lib\imguizmo.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
    <ItemGroup>
      <None Remove="Assets\Locales\ru.json" />
      <EmbeddedResource Include="Assets\Locales\ru.json" />
      <None Remove="Assets\Locales\en.json" />
      <EmbeddedResource Include="Assets\Locales\en.json" />
    </ItemGroup>

</Project>
